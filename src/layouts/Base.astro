---
import '../styles/main.css';
import { SITE } from '../site';
const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={SITE.name} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="container">
      <header class="site-bar">
        <a class="mark" href="/" aria-label={`${SITE.name}, home`} aria-current={isHome ? 'page' : undefined}>
          <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 4C32 4 12 28 12 40a20 20 0 0 0 40 0C52 28 32 4 32 4Z" /></svg>
          <span>{SITE.name}</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a href="/#writing">Writing</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-foot">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span>Written in Ho Chi Minh City</span>
      </footer>
    </div>
  </body>
</html>
