---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const iso = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <section class="intro">
    <h1>{SITE.intro}</h1>
    {SITE.about.map((line) => <p>{line}</p>)}
  </section>

  <section id="writing" class="writing" aria-labelledby="writing-title">
    <h2 id="writing-title" class="label">Writing</h2>
    {posts.length === 0 && <p class="muted">The first post is on its way.</p>}
    <ol class="posts">
      {posts.map((p) => (
        <li>
          <time class="meta" datetime={p.data.date.toISOString()}>{iso(p.data.date)}</time>
          <a href={`/posts/${p.id}/`}><span>{p.data.title}</span></a>
        </li>
      ))}
    </ol>
  </section>
</Base>
